{
  "permissions": {
    "ask": [
      "Edit(/lib/supabase-admin.ts)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-inline-node.mjs\""
          }
        ]
      }
    ]
  }
}
